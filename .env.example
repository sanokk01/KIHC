# Local development URL. Replace this with the purchased production domain later.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Dashboard > Connect에서 제공하는 PostgreSQL 연결 문자열을 사용하세요.
# 배포 환경에서는 서버리스용 pooler URL 사용을 권장합니다.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres

# Netlify Functions + Supabase Transaction Pooler에서는 1을 권장합니다.
DB_POOL_MAX=1
